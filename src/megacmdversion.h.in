#ifndef MEGACMDVERSION_H
#define MEGACMDVERSION_H

#ifndef SDK_COMMIT_HASH
#define SDK_COMMIT_HASH "@SDK_COMMIT_HASH@"
#endif

#ifndef MEGACMD_MAJOR_VERSION
#define MEGACMD_MAJOR_VERSION @MEGACMD_MAJOR_VERSION@
#endif
#ifndef MEGACMD_MINOR_VERSION
#define MEGACMD_MINOR_VERSION @MEGACMD_MINOR_VERSION@
#endif
#ifndef MEGACMD_MICRO_VERSION
#define MEGACMD_MICRO_VERSION @MEGACMD_MICRO_VERSION@
#endif

#ifndef MEGACMD_BUILD_ID
#define MEGACMD_BUILD_ID 0
#endif

#ifndef MEGACMD_CODE_VERSION
#define MEGACMD_CODE_VERSION (MEGACMD_BUILD_ID+MEGACMD_MICRO_VERSION*100+MEGACMD_MINOR_VERSION*10000+MEGACMD_MAJOR_VERSION*1000000)
#endif
namespace megacmd {

const char * const megacmdchangelog =
        "Faster uploads, especially of many small files""\n"
        "FUSE: mounts now stream files, so they open at once instead of after a full download""\n"
        "FUSE: reads through a mount skip the integrity check a full download does. Use \"get\" for files meant to be run or installed. See \"help --streaming\"""\n"
        "Transfers and streaming now indicate when they wait for transfer quota or for free storage""\n"
        "mv: moving a folder onto a file no longer deletes the file""\n"
        "mkdir, put, mv and cp no longer create items named \".\" or \"..\"""\n"
        "Hardened webdav, ftp and local session file handling""\n"
        "Stability, memory, typos and other improvements"

        ;
}//end namespace
#endif // VERSION_H

